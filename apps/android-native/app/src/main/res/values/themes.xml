<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Окно до первого кадра Compose: тёмная поверхность схемы (#17130E), без панели действий.
         Сам интерфейс рисует Compose (PiTheme). -->
    <style name="Theme.PiMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pimusic_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Заставка (androidx.core.splashscreen; на Android 12+ — системная) -->
    <style name="Theme.PiMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pimusic_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.PiMusic</item>
    </style>
</resources>
