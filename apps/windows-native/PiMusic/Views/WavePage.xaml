<?xml version="1.0" encoding="utf-8"?>
<!-- «Моя Волна»: большая карточка эфира (обложка, что играет, слушатели, «Слушать»), обновить плейлист, найти новое. -->
<Page
    x:Class="PiMusic.Views.WavePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Прямой потомок ScrollViewer — во всю ширину, ограничение — колонкой (см. PageContentMaxWidth в Templates.xaml). -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="{StaticResource PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <TextBlock Text="Моя Волна" Style="{StaticResource TitleTextBlockStyle}" />

                <Border Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="32" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="240" Height="240" CornerRadius="8" Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                Translation="0,0,16">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;" FontSize="64" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Image x:Name="M0" Stretch="UniformToFill" />
                                    <Image x:Name="M1" Grid.Column="1" Stretch="UniformToFill" />
                                    <Image x:Name="M2" Grid.Row="1" Stretch="UniformToFill" />
                                    <Image x:Name="M3" Grid.Row="1" Grid.Column="1" Stretch="UniformToFill" />
                                </Grid>
                                <Image x:Name="NowCover" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="Kicker" Text="Бесконечный эфир из вашей медиатеки" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TitleText" Text="Слушайте свою музыку без конца" Style="{StaticResource TitleLargeTextBlockStyle}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ArtistText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ListenersText" Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Padding="20,10" Click="Play_Click"
                                    AutomationProperties.Name="Слушать «Мою Волну»">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock x:Name="PlayText" Text="Слушать" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Настроить эфир" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RefreshButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE72C;" FontSize="20" />
                            <StackPanel>
                                <TextBlock Text="Обновить плейлист" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Пересобрать эфир из медиатеки" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiscoverButton" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12"
                            Click="Discover_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE734;" FontSize="20" />
                            <StackPanel>
                                <TextBlock Text="Найти новое" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Похожие треки скачаются в медиатеку" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />

                <StackPanel x:Name="FoundPanel" Visibility="Collapsed" Spacing="4">
                    <TextBlock Text="Добавляется в медиатеку" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,4" />
                    <ItemsControl x:Name="FoundList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyTextBlockStyle}" Margin="0,4" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
