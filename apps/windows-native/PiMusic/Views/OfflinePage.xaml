<?xml version="1.0" encoding="utf-8"?>
<!-- «Скачанное»: треки на компьютере (играют без сети), группы — альбом/плейлист, откуда скачали; прогресс, удаление. -->
<Page
    x:Class="PiMusic.Views.OfflinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:player="using:PiMusic.Player"
    xmlns:views="using:PiMusic.Views">

    <Page.Resources>
        <DataTemplate x:Key="OfflineRow" x:DataType="player:OfflineItem">
            <Grid Height="56" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image Source="{x:Bind views:Ui.Cover40(Track.CoverUri)}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Track.Title}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Track.Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ProgressRing Width="20" Height="20" Margin="0,0,4,0" IsIndeterminate="False" Maximum="100"
                                  Value="{x:Bind Percent, Mode=OneWay}" IsActive="{x:Bind Active, Mode=OneWay}"
                                  Visibility="{x:Bind views:Ui.Show(Active), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" MinWidth="72" TextAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="8" Tag="{x:Bind}" Click="Retry_Click"
                            Visibility="{x:Bind views:Ui.Show(Failed), Mode=OneWay}"
                            ToolTipService.ToolTip="Скачать ещё раз" AutomationProperties.Name="Повторить">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="8" Tag="{x:Bind}" Click="Remove_Click"
                            ToolTipService.ToolTip="Удалить с компьютера" AutomationProperties.Name="Удалить с компьютера">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Скачанное" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Click="Play_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Слушать всё" />
                    </StackPanel>
                </Button>
                <Button x:Name="ShuffleButton" Click="Shuffle_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock Text="Перемешать" />
                    </StackPanel>
                </Button>
                <Button Click="Clear_Click" AutomationProperties.Name="Удалить всё" ToolTipService.ToolTip="Удалить всё скачанное">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="List" Grid.Row="1" Padding="24,0,24,24" SelectionMode="Extended" ItemTemplate="{StaticResource OfflineRow}"
                  DoubleTapped="List_DoubleTapped" KeyDown="List_KeyDown" ContextRequested="List_ContextRequested"
                  AutomationProperties.Name="Скачанные треки">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="views:OfflineGroup">
                            <TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <StackPanel x:Name="Empty" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
            <FontIcon Glyph="&#xE78C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Здесь пока пусто" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="В меню трека, альбома или плейлиста — «Скачать на компьютер». Скачанное играет без сети и хранится, пока вы его не удалите." />
        </StackPanel>
    </Grid>
</Page>
