<?xml version="1.0" encoding="utf-8"?>
<!-- Эквалайзер в стиле «Параметров» Windows 11: карточки, кривая АЧХ, 10 вертикальных полос и преамп. -->
<Page
    x:Class="PiMusic.Views.EqualizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,28,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="1072" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock Text="Эквалайзер" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <tk:SettingsCard Header="Эквалайзер" Description="10 полос, преамп и лимитер — для всего, что играет PiMusic">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="EnabledSwitch" Toggled="Enabled_Toggled" OnContent="Вкл." OffContent="Выкл." />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Пресет" Description="Встроенные и свои пресеты общие для всех ваших устройств">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8FD;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="PresetBox" MinWidth="220" SelectionChanged="Preset_Changed" AutomationProperties.Name="Пресет" />
                    <Button Padding="8" ToolTipService.ToolTip="Ещё" AutomationProperties.Name="Действия с пресетом">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Сохранить как пресет…" Click="SavePreset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="RenameItem" Text="Переименовать пресет…" Click="RenamePreset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DeleteItem" Text="Удалить пресет" Click="DeletePreset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Сбросить в «Ровно»" Click="Reset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </tk:SettingsCard>

            <!-- Кривая и полосы -->
            <Border Margin="0,4,0,0" Padding="20,16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid Height="120">
                        <Border CornerRadius="4" Background="{ThemeResource ControlAltFillColorTertiaryBrush}" SizeChanged="Curve_SizeChanged">
                            <Canvas x:Name="Curve">
                                <Line x:Name="ZeroLine" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="4,4" />
                                <Polyline x:Name="CurveLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Border>
                        <TextBlock Text="+12 дБ" Style="{StaticResource CaptionTextBlockStyle}" Margin="8,4" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="−12 дБ" Style="{StaticResource CaptionTextBlockStyle}" Margin="8,4" VerticalAlignment="Bottom"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <Grid x:Name="BandsGrid" ColumnSpacing="4" />
                    <TextBlock Text="Щелчок по частоте — точная настройка полосы: частота, ширина, тип."
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Устройство" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="Одинаково на всех устройствах" Description="Выключите, чтобы настроить звук только для этого компьютера">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="SyncSwitch" Toggled="Sync_Toggled" OnContent="Вкл." OffContent="Выкл." />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Лимитер" Description="Не даёт подъёму полос и громкости перегружать звук">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7BA;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="LimiterSwitch" Toggled="Limiter_Toggled" OnContent="Вкл." OffContent="Выкл." />
            </tk:SettingsCard>
            <TextBlock x:Name="DeviceText" Style="{StaticResource CaptionTextBlockStyle}" Margin="1,8,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
