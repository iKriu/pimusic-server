<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PiMusic.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:PiMusic.Data"
    xmlns:views="using:PiMusic.Views"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- Плитка плейлиста: мозаика, значок «Общий», имя, подпись. -->
        <DataTemplate x:Key="PlaylistTile" x:DataType="data:Playlist">
            <StackPanel Width="160" Spacing="8" Padding="0,0,0,8">
                <Grid Width="160" Height="160">
                    <views:PlaylistMosaic Width="160" Height="160" DecodeSize="160" Covers="{x:Bind CoverUris}" />
                    <Border Width="28" Height="28" CornerRadius="14" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind views:Ui.Show(Shared)}"
                            ToolTipService.ToolTip="Общий плейлист">
                        <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
                <StackPanel>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Плейлисты" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Style="{StaticResource AccentButtonStyle}" Click="New_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Новый плейлист" />
                    </StackPanel>
                </Button>
                <Button Click="Join_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock Text="Вступить по ссылке" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <GridView x:Name="Tiles" Grid.Row="1" Padding="{StaticResource PageTilesPadding}" IsItemClickEnabled="True" SelectionMode="None"
                  ItemTemplate="{StaticResource PlaylistTile}" ItemClick="Tiles_ItemClick" ContextRequested="Tiles_ContextRequested"
                  AutomationProperties.Name="Плейлисты" />
        <StackPanel x:Name="Empty" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
            <FontIcon Glyph="&#xE90B;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Создайте первый плейлист" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
            <TextBlock Text="Собирайте треки в подборки и делитесь ими с друзьями." Style="{StaticResource BodyTextBlockStyle}"
                       TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="Новый плейлист" Click="New_Click" />
        </StackPanel>
        <ProgressRing x:Name="Busy" Grid.Row="1" IsActive="True" />
    </Grid>
</Page>
