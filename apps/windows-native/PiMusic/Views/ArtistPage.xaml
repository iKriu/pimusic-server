<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PiMusic.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:PiMusic.Data"
    xmlns:views="using:PiMusic.Views">

    <Page.Resources>
        <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" ItemsPath="Tracks" />
    </Page.Resources>

    <Grid>
        <ListView x:Name="List" ItemsSource="{x:Bind Groups.View, Mode=OneWay}" ItemTemplate="{StaticResource TrackRow}"
                  Padding="{StaticResource PageListPadding}" AutomationProperties.Name="Треки исполнителя">
            <ListView.Header>
                <Grid Margin="16,24,16,16" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture x:Name="Photo" Width="144" Height="144" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Исполнитель" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NameText" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="InfoText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="Play_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Слушать" />
                                </StackPanel>
                            </Button>
                            <Button Click="Shuffle_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                    <TextBlock Text="Перемешать" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ListView.Header>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="data:AlbumGroup">
                            <HyperlinkButton Padding="4" Tag="{x:Bind Key}" Click="Album_Click" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="48" Height="48" CornerRadius="4" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                                        <Image Source="{x:Bind views:Ui.Cover48(CoverUri)}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HyperlinkButton>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
        <ProgressRing x:Name="Busy" IsActive="True" />
    </Grid>
</Page>
