<?xml version="1.0" encoding="utf-8"?>
<!-- «Сейчас играет»: большая обложка слева, справа — очередь или синхронный текст. -->
<Page
    x:Class="PiMusic.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:PiMusic.Data"
    xmlns:views="using:PiMusic.Views">

    <Grid x:Name="Root" Padding="36,24" ColumnSpacing="48" RowSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="2*" MaxWidth="480" />
            <ColumnDefinition x:Name="RightCol" Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="*" />
            <RowDefinition x:Name="BottomRow" Height="0" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="TrackPanel" VerticalAlignment="Center" Spacing="20" MaxWidth="420">
            <Border CornerRadius="8" Background="{ThemeResource ControlAltFillColorTertiaryBrush}" Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Viewbox MaxWidth="420" Stretch="Uniform">
                        <Grid Width="420" Height="420">
                            <FontIcon Glyph="&#xEC4F;" FontSize="96" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{x:Bind views:Ui.TrackCover420(P.Current), Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind views:PlayerBar.TitleOf(P.Current), Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="Wrap" MaxLines="2" IsTextSelectionEnabled="True" />
                <HyperlinkButton Padding="0" Click="Artist_Click" Content="{x:Bind views:Ui.ArtistOf(P.Current), Mode=OneWay}"
                                 FontSize="16" />
                <HyperlinkButton Padding="0" Click="Album_Click" Content="{x:Bind views:Ui.AlbumOf(P.Current), Mode=OneWay}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar Severity="Warning" IsClosable="True" IsOpen="{x:Bind views:NowPlayingPage.HasError(P.Error), Mode=OneWay}"
                     Message="{x:Bind P.Error, Mode=OneWay}" />
        </StackPanel>

        <Grid x:Name="SidePanel" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" Margin="-12,0,0,0">
                    <SelectorBarItem x:Name="QueueTab" Text="Очередь" IsSelected="True" />
                    <SelectorBarItem x:Name="LyricsTab" Text="Текст" />
                </SelectorBar>
                <Button x:Name="ClearButton" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Click="Clear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                        <TextBlock Text="Очистить" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListView x:Name="QueueList" Grid.Row="1" ItemsSource="{x:Bind P.Queue}" ItemTemplate="{StaticResource TrackRow}"
                      SelectionMode="Single" DoubleTapped="QueueList_DoubleTapped" KeyDown="QueueList_KeyDown"
                      ContextRequested="QueueList_ContextRequested" Margin="-16,0" AutomationProperties.Name="Очередь" />

            <Grid x:Name="LyricsPanel" Grid.Row="1" Visibility="Collapsed">
                <ListView x:Name="LyricsList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="LyricsList_ItemClick"
                          Margin="-16,0" AutomationProperties.Name="Текст песни">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="data:LyricLine">
                            <TextBlock Text="{x:Bind Text}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" Padding="0,6" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer x:Name="PlainScroll" Visibility="Collapsed">
                    <TextBlock x:Name="PlainText" Style="{StaticResource BodyLargeTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               LineHeight="28" />
                </ScrollViewer>
                <TextBlock x:Name="LyricsEmpty" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Текста для этого трека нет" />
                <ProgressRing x:Name="LyricsLoading" IsActive="False" />
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightCol.Width" Value="0" />
                        <Setter Target="LeftCol.MaxWidth" Value="100000" />
                        <Setter Target="TopRow.Height" Value="Auto" />
                        <Setter Target="BottomRow.Height" Value="*" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                        <Setter Target="TrackPanel.MaxWidth" Value="260" />
                        <Setter Target="TrackPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="Root.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
