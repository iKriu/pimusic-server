<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PiMusic.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PiMusic.Views">

    <Grid>
        <ListView x:Name="List" ItemTemplate="{StaticResource TrackRow}" Padding="{StaticResource PageListPadding}" AutomationProperties.Name="Треки плейлиста"
                  DragItemsCompleted="List_DragItemsCompleted">
            <ListView.Header>
                <StackPanel Spacing="12" Margin="16,24,16,8">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="200" Height="200" CornerRadius="8" Translation="0,0,16">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <views:PlaylistMosaic x:Name="Mosaic" Width="200" Height="200" DecodeSize="200" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Плейлист" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TitleText" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" />
                                <TextBlock x:Name="DescText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="4" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="SharedChip" Visibility="Collapsed" Padding="8,2" CornerRadius="12" Click="Members_Click"
                                            ToolTipService.ToolTip="Участники">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE716;" FontSize="12" />
                                            <TextBlock Text="Общий" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="InfoText" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Click="Play_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Слушать" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShuffleButton" Click="Shuffle_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                        <TextBlock Text="Перемешать" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MoreButton" Click="More_Click" AutomationProperties.Name="Ещё" ToolTipService.ToolTip="Ещё">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="NotOwnedBar" IsOpen="False" IsClosable="False" Severity="Informational"
                             Message="Часть треков не в вашей медиатеке — «Сохранить в медиатеку» добавит их без скачивания.">
                        <InfoBar.ActionButton>
                            <Button Content="Сохранить в медиатеку" Click="Save_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HintText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Перетаскивайте треки мышью, чтобы изменить порядок" />
                        <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="220" SelectionChanged="SortBox_SelectionChanged"
                                  AutomationProperties.Name="Сортировка" />
                        <Button x:Name="OrderButton" Grid.Column="2" Click="Order_Click" AutomationProperties.Name="Порядок">
                            <FontIcon x:Name="OrderIcon" Glyph="&#xE74A;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ListView.Header>
            <ListView.Footer>
                <StackPanel x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="8" Margin="0,48,0,0" MaxWidth="360">
                    <FontIcon Glyph="&#xE90B;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="В плейлисте пока пусто" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                    <TextBlock Text="Добавляйте треки через контекстное меню → «Добавить в плейлист…»." Style="{StaticResource BodyTextBlockStyle}"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
        <ProgressRing x:Name="Busy" IsActive="True" />
    </Grid>
</Page>
