<?xml version="1.0" encoding="utf-8"?>
<!-- Оболочка в духе Windows 11: Mica, своя строка заголовка с поиском, NavigationView слева, панель плеера внизу. -->
<Window
    x:Class="PiMusic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PiMusic.Views"
    Title="PiMusic">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="PiMusic" IsBackButtonVisible="True" IsPaneToggleButtonVisible="False"
                  BackRequested="TitleBar_BackRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/icon.png" />
            </TitleBar.IconSource>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Поиск музыки" QueryIcon="Find" MinWidth="280" MaxWidth="520"
                            VerticalAlignment="Center" QuerySubmitted="SearchBox_QuerySubmitted"
                            AutomationProperties.Name="Поиск музыки" />
        </TitleBar>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False" IsSettingsVisible="True" OpenPaneLength="260"
                        CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1100"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Медиатека" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Плейлисты" Tag="playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Исполнители" Tag="artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Альбомы" Tag="albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Скачанное" Tag="offline">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE78C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Моя Волна" Tag="wave">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Радио" Tag="radio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC05;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Найти и скачать" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DownloadsItem" Content="Загрузки" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="DownloadsBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Сейчас играет" Tag="now">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
                <InfoBar x:Name="ToastBar" IsOpen="False" IsClosable="True" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                         MaxWidth="560" Margin="24" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            </Grid>
        </NavigationView>

        <views:PlayerBar x:Name="Bar" Grid.Row="2" />

        <!-- Экран входа закрывает навигацию и плеер, пока нет токена. -->
        <Frame x:Name="LoginFrame" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
