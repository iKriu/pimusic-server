# =====================================================================
#  PiMusic — единственный файл настроек. Скопируйте в .env и заполните
#  блок «ОБЯЗАТЕЛЬНО». Всё остальное install.sh заполнит сам.
# =====================================================================

# ---------------------- ОБЯЗАТЕЛЬНО ----------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Секретный код, который вы раздаёте друзьям: /register <код> <логин> <пароль>
INVITE_CODE=
# Администратор Jellyfin (создаётся автоматически при установке)
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=
# Аккаунт Soulseek (если такого ника ещё нет — сеть зарегистрирует его при первом входе)
SLSK_USERNAME=
SLSK_PASSWORD=
# Ключ Last.fm API: https://www.last.fm/api/account/create (нужен для /wave)
LASTFM_API_KEY=

# ---------------------- НЕОБЯЗАТЕЛЬНО --------------------------------
# Ваш Telegram ID (узнать: @userinfobot) — получите админ-команды /status, /users, /radio_del
ADMIN_TELEGRAM_IDS=
# Название сервера в Jellyfin
SERVER_NAME=PiMusic
# Часовой пояс контейнеров — должен совпадать с хостом (timedatectl). Пусто = install.sh возьмёт пояс хоста.
TZ=
# Логин/пароль веб-панели slskd (пароль сгенерируется, если пусто)
SLSKD_WEB_USER=admin
SLSKD_WEB_PASSWORD=
# Второй аккаунт Soulseek для sockseek (sldl): сеть не пускает два клиента под одним ником одновременно.
# Если пусто — будет <SLSK_USERNAME>_pm с тем же паролем.
SLDL_SLSK_USERNAME=
SLDL_SLSK_PASSWORD=
SLDL_LISTEN_PORT=50301
# Spotify API (необязательно: spotDL 4.5+ читает публичные ссылки без ключей)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Почта для User-Agent MusicBrainz (их правила требуют контакт)
CONTACT_EMAIL=
# Адрес сервера в локальной сети (определяется автоматически)
PUBLIC_HOST=
# Публичный адрес для ссылок на живой поток «Моя Волна», если перед сервером стоит reverse-proxy
# (Nginx Proxy Manager / Caddy) с location /stream/ -> http://<IP сервера>:8097. Пример: https://music.example.com
STREAM_PUBLIC_URL=
# Адрес Jellyfin для людей и приложений (Finamp, Symfonium). Пусто = домен из STREAM_PUBLIC_URL, если он https,
# иначе http://PUBLIC_HOST:8096. Пример: https://music.example.com
JELLYFIN_PUBLIC_URL=
# Где хранить данные (медиатеки, конфиги). Всё должно быть на ОДНОМ разделе — ради жёстких ссылок.
DATA_DIR=/srv/pimusic
# Пользователь, от имени которого работают контейнеры (определяется автоматически)
PUID=
PGID=

# ---------------------- ТОНКАЯ НАСТРОЙКА -----------------------------
DOWNLOAD_WORKERS=2
MAX_PLAYLIST_TRACKS=300
WAVE_SIZE=10
WAVE_PLAYLIST_SIZE=100
# Показывать личные «Волны» каналами Live TV (тогда их увидят все пользователи с Live TV)
WAVE_IN_LIVETV=false
# Админ видит в плеере все медиатеки (по умолчанию — только свою)
ADMIN_SEES_ALL_LIBRARIES=false
SOULSEEK_SEARCH_TIMEOUT=25
SOULSEEK_DOWNLOAD_TIMEOUT=600
ALLOW_FLAC_TRANSCODE=true
# Вход в PWA / приложения через виджет Telegram Login (нужен /setdomain у @BotFather, см. README)
LOGIN_WIDGET=false
# Доп. Origin для CORS через запятую (tauri://localhost, capacitor://localhost и localhost уже разрешены)
CORS_ORIGINS=
# Загрузка своих файлов (бот: до 20 МБ — ограничение Telegram; Mini App: до UPLOAD_MAX_MB)
# Ключ AcoustID (необязательно, бесплатно): https://acoustid.org/new-application — войти, «Register a new
# application», скопировать API key. С ним файлы без тегов опознаются по звуку (нужен fpcalc/chromaprint).
ACOUSTID_API_KEY=
UPLOAD_MAX_MB=300
# Не принимать файлы, если на диске свободно меньше N ГБ
UPLOAD_MIN_FREE_GB=5
UPLOAD_WORKERS=1
# Сколько ГБ файлов одного пользователя может ждать обработки
UPLOAD_USER_QUOTA_GB=10
# Адрес(а) reverse-proxy (CIDR через запятую), которым верим в X-Forwarded-For — укажите IP вашего NPM/Caddy,
# например 192.168.1.2/32. Пусто = только localhost: тогда за прокси лимиты входа считаются по адресу прокси.
TRUSTED_PROXIES=
# Фоновый расчёт громкости треков (EBU R128 через ffmpeg) для нормализации в плеере
LOUDNESS_ANALYSIS=true
ITUNES_COUNTRIES=US,RU
STREAM_BITRATE=320k
JELLYFIN_UI_CULTURE=ru
JELLYFIN_COUNTRY=RU
JELLYFIN_METADATA_LANG=ru
JELLYFIN_VERSION=10.11.11
SLSKD_VERSION=0.26.1
SOCKSEEK_REF=v3.0.6
LOG_LEVEL=INFO
# Лимиты ресурсов контейнеров (docker-compose.yml): по умолчанию jellyfin 2g/2.0, slskd 1g/1.5, bot 2g/2.0
#JELLYFIN_MEM_LIMIT=2g
#JELLYFIN_CPUS=2.0
#SLSKD_MEM_LIMIT=1g
#SLSKD_CPUS=1.5
#BOT_MEM_LIMIT=2g
#BOT_CPUS=2.0

# ---------------------- ЗАПОЛНЯЕТСЯ АВТОМАТИЧЕСКИ --------------------
SLSKD_API_KEY=
